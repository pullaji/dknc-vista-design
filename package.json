{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run minify:html && npm run optimize-scripts",
    "build:dev": "vite build --mode development",
    "build:prod": "npm run batch-convert && vite build && npm run minify:html && npm run optimize-scripts",
    "build:analyze": "vite build && npm run minify:html && npm run optimize-scripts",
    "lint": "eslint .",
    "preview": "vite preview",
    "minify:html": "node scripts/post-build-optimize.js",
    "minify:css": "cleancss -o dist/assets/style.min.css dist/assets/*.css",
    "minify:js": "terser dist/assets/*.js -c -m -o dist/assets/bundle.min.js",
    "critical-css": "node scripts/extract-critical-css.js",
    "optimize-scripts": "node scripts/optimize-script-loading.js",
    "convert-webp": "node scripts/convert-to-webp.js",
    "batch-convert": "node scripts/batch-convert-webp.js",
    "optimize-images": "imagemin \"public/assets/**/*.{jpg,png,JPG}\" --out-dir=dist/images --plugin=webp"
  },
